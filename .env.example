# Copy to .env and fill in what your model route needs (docs/configuration.md).
# The launchers (scripts/search_epoch.sh) and the model layer read .env from the repository root.

# GitHub API access for the search agents and the workers' containers.
GITHUB_TOKEN=

# Route claude-code/<model>: the `claude` CLI must be on PATH and logged in (nothing here),
# or set ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_EFFORT=medium
# CLAUDE_CODE_TIMEOUT=180

# Route openrouter/<provider>/<model>: OpenRouter, direct.
# OPENROUTER_KEY=
# OPENROUTER_PROVIDER_ORDER=any

# Route openai/<model>: any OpenAI-compatible endpoint. Set all four to the
# same endpoint and key.
# LITELLM_BASE_URL=
# LITELLM_KEY=
# OPENAI_API_BASE=
# OPENAI_API_KEY=

# Optional host Maven cache (infra/maven-cache/run.sh).
# BENCH_CACHE_URL=http://172.17.0.1:8081
